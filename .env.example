# Cloudflare R2 — required for video on Zero Data Retention accounts.
# Create tokens: https://dash.cloudflare.com → R2 → Manage R2 API Tokens
#
# Account ID: wrangler whoami  (or R2 overview page)
# Bucket:     reelvideoproduction-boards  (already exists in this repo)

CANVAS_S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
CANVAS_S3_BUCKET=reelvideoproduction-boards
CANVAS_S3_ACCESS_KEY_ID=
CANVAS_S3_SECRET_ACCESS_KEY=
CANVAS_S3_REGION=auto

# Optional: force path-style URLs (R2 accepts virtual-hosted by default)
# CANVAS_S3_FORCE_PATH_STYLE=1

# One-off alternative to S3 credentials (not for concurrent runs):
# CANVAS_UPLOAD_URL=https://...presigned PUT...
# CANVAS_DOWNLOAD_URL=https://...presigned GET...
